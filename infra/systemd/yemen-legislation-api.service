[Unit]
Description=Yemen Legislation Platform API
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
User=yemen-legislation
Group=yemen-legislation
WorkingDirectory=/opt/yemen-legislation/current
EnvironmentFile=/etc/yemen-legislation/platform.env
ExecStart=/usr/bin/node apps/api/dist/main.js
Restart=on-failure
RestartSec=4
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yemen-legislation
UMask=0027

[Install]
WantedBy=multi-user.target

