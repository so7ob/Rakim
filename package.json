{
  "name": "yemen-legislation-platform",
  "version": "0.1.0",
  "private": true,
  "description": "منصة تشريعات يمنية محلية تحفظ النصوص والنسخ الزمنية ومصادرها",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,yellow,magenta \"npm run dev -w @ylp/api\" \"npm run dev -w @ylp/worker\" \"node scripts/dev/wait-for-api.mjs && npm run dev -w @ylp/web\"",
    "build": "npm run build -w @ylp/api && npm run build -w @ylp/worker && npm run build -w @ylp/web",
    "start": "npm run start -w @ylp/api",
    "start:worker": "npm run start -w @ylp/worker",
    "lint": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "test:unit": "npm run test:unit -w @ylp/api && npm run test:unit -w @ylp/web",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/test/search-performance.mjs",
    "test:infra": "bash scripts/test/infra-config.sh",
    "visual:reference": "node scripts/reference/capture-reference.mjs",
    "visual:implementation": "node scripts/reference/capture-implementation.mjs",
    "visual:workflow": "node scripts/reference/capture-workflow-controls.mjs",
    "visual:admin": "node scripts/reference/capture-admin-ui.mjs",
    "visual:compare": "node scripts/reference/compare-visuals.mjs",
    "visual:provided": "node scripts/reference/compare-provided-screenshots.mjs",
    "db:migrate": "npm run db:migrate -w @ylp/api",
    "db:revert": "npm run db:revert -w @ylp/api",
    "seed": "npm run seed -w @ylp/api",
    "reindex": "npm run reindex -w @ylp/api",
    "backup": "bash scripts/backup/backup.sh",
    "restore:check": "bash scripts/restore/restore-check.sh",
    "db:check": "npm run db:check -w @ylp/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "concurrently": "9.2.4",
    "prettier": "^3.9.6"
  }
}
